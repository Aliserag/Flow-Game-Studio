class_name Palette
## Warband art-bible colour palette (§5).
## Use these constants everywhere instead of inline Color literals.

## Old Vellum — body text on dark panels.
const OLD_VELLUM := Color(0.831, 0.722, 0.588, 1.0)   # #D4B896

## Warband Gold — accent text, player-side labels.
const WARBAND_GOLD := Color(0.788, 0.659, 0.298, 1.0)  # #C9A84C

## Fell Red — kill-banner text, dead orc names, danger states.
const FELL_RED := Color(0.545, 0.102, 0.102, 1.0)      # #8B1A1A

## Night Slate — primary dark background.
const NIGHT_SLATE := Color(0.102, 0.102, 0.122, 1.0)   # #1A1A1F

## Pure white — attacker name in kill-banner.
const WHITE := Color(1.0, 1.0, 1.0, 1.0)

## Dim bone — enemy body-text on dark panels.
const BONE := Color(0.8, 0.8, 0.8, 1.0)
