[gd_scene load_steps=3 format=3 uid="uid://game_over_screen"]

[ext_resource type="Script" path="res://src/ui/game_over_screen.gd" id="1_gameover"]
[ext_resource type="Theme" path="res://assets/themes/warband_theme.tres" id="2_theme"]

[node name="GameOverScreen" type="Control"]
theme = ExtResource("2_theme")
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_gameover")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.102, 0.102, 0.122, 1.0)

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="TitleLabel" type="Label" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0.0, 28.0)
text = "THE WARBAND IS BROKEN"
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.545, 0.102, 0.102, 1.0)
horizontal_alignment = 1
vertical_alignment = 1

[node name="SubtitleLabel" type="Label" parent="VBox"]
layout_mode = 2
text = ""
theme_override_font_sizes/font_size = 9
theme_override_colors/font_color = Color(0.831, 0.722, 0.588, 1.0)
horizontal_alignment = 1
autowrap_mode = 2

[node name="StatsLabel" type="Label" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0.0, 24.0)
text = ""
theme_override_font_sizes/font_size = 8
theme_override_colors/font_color = Color(0.831, 0.722, 0.588, 1.0)
horizontal_alignment = 1
autowrap_mode = 2

[node name="FallenTitle" type="Label" parent="VBox"]
layout_mode = 2
text = "THOSE WHO FELL:"
theme_override_font_sizes/font_size = 9
theme_override_colors/font_color = Color(0.545, 0.102, 0.102, 1.0)
horizontal_alignment = 1

[node name="ScrollContainer" type="ScrollContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="GraveList" type="VBoxContainer" parent="VBox/ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3

[node name="NewCampaignButton" type="Button" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0.0, 22.0)
text = "Start New Campaign"
